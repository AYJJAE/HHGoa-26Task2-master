# Google Gemini API Key — required for generative answers (falls back to extractive without it)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key — required for Speech-to-Text
SARVAM_API_KEY=your_sarvam_api_key_here

# Comma-separated list of allowed frontend origins for CORS (use * for development)
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.vercel.app

# Grounding overlap threshold (0.0 - 1.0). Higher = stricter grounding validation.
GROUNDING_THRESHOLD=0.6
