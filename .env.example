# ===================================================
# Hacker House Goa 2026 — Task 2: Multilingual Voice RAG
# Environment Variables Configuration Template
# ===================================================

# LLM & Generation (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Primary STT (ElevenLabs Scribe v2)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TIMEOUT_MS=5000

# Fallback STT (Sarvam AI Saaras v3)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix

# Vector Store & Hybrid Retrieval
QDRANT_LOCAL_PATH=qdrant_db
RAG_FINAL_TOP_K=5
RAG_QUERY_EMBED_CACHE_SIZE=512

# Decision & Grounding Thresholds
GROUNDING_THRESHOLD=0.55
RELEVANCE_MIN_SCORE=0.35

# Server & Network Configuration
PORT=8080
ALLOWED_ORIGINS=*

# Frontend Environment Variables (for frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
